Yes. First check whether the API key is intended for browser use.
- Private server key: keep it in the backend’s environment configuration. Vue calls that backend.
- Browser-approved key: your frontend can send it using the documented header.
A VITE_* value is visible in the browser—even when stored in .env.local. It cannot hide a private secret. Vite

Below is a small Vue example for a browser-approved key. It uses GearDesk’s endpoint and response format.

1. Frontend .env.local
VITE_API_BASE_URL=http://localhost/geardesk-api/index.php

# Leave empty for our current GearDesk API.
# Fill only with a key explicitly permitted for frontend use.
VITE_PUBLIC_API_KEY=

Restart Vite after changing this file.

2. Example component — JavaScript, HTML, and CSS
<script setup>
import { ref } from "vue";
import { token } from "../auth.js";

const API_URL = import.meta.env.VITE_API_BASE_URL;
const API_KEY = import.meta.env.VITE_PUBLIC_API_KEY;

const equipment = ref([]);
const loading = ref(false);
const statusMessage = ref("");

async function loadEquipment() {
  if (loading.value) return;

  loading.value = true;
  statusMessage.value = "Loading equipment...";

  try {
    if (!API_URL) {
      throw new Error("Configure the API URL first.");
    }

    const headers = {
      Accept: "application/json"
    };

    // Include the login token when one exists.
    if (token.value) {
      headers.Authorization = "Bearer " + token.value;
    }

    // Example header name: use the API's documented name.
    // Add this only for a browser-approved API key.
    if (API_KEY) {
      headers["X-API-Key"] = API_KEY;
    }

    const response = await fetch(
      API_URL + "?resource=equipment&page=1&per_page=5",
      {
        method: "GET",
        headers
      }
    );

    const result = await response.json();

    if (!response.ok) {
      throw new Error(
        result.message ||
        "Request failed. Check the API's authentication requirements."
      );
    }

    // GearDesk places its records inside result.data.
    if (!Array.isArray(result.data)) {
      throw new Error("Unexpected API response format.");
    }

    equipment.value = result.data;
    statusMessage.value = "Equipment loaded.";
  } catch (error) {
    statusMessage.value =
      error.message || "Unable to connect to the API.";
  } finally {
    loading.value = false;
  }
}
</script>

<template>
  <section class="api-example">
    <h1>Equipment</h1>

    <button
      type="button"
      :disabled="loading"
      @click="loadEquipment"
    >
      {{ loading ? "Loading..." : "Load equipment" }}
    </button>

    <!-- Display messages without displaying the key itself. -->
    <p role="status">{{ statusMessage }}</p>

    <div v-if="equipment.length" class="table-container">
      <table>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Category</th>
            <th scope="col">Available units</th>
          </tr>
        </thead>

        <tbody>
          <tr v-for="item in equipment" :key="item.id">
            <td>{{ item.name }}</td>
            <td>{{ item.category_name }}</td>
            <td>{{ item.available_units }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</template>

